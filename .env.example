# Copy to automation/.env and fill in. Never commit the real .env.

DD_APP_URL=https://qa.done.deals/
DD_API_URL=https://qa.done.deals/api/company-service/v1/

# Saved browser sessions, created with: python scripts/save_auth_state.py <role>
# Buyer and admin: before phase 1. Seller: after phase 1, once you have the seller's credentials.
DD_BUYER_STATE=auth/buyer.json
DD_SELLER_STATE=auth/seller.json
DD_ADMIN_STATE=auth/admin.json
# star-seller-fundraising: a biz user (userType 4), saved with: python scripts/save_auth_state.py biz_user
DD_BIZ_USER_STATE=auth/biz_user.json

# Optional. Seller company id for /deals/:companyId; blank = the logged-in seller's own company.
DD_SELLER_COMPANY_ID=
# Optional. Test buyer's name in the seller's Interest Received table; blank = newest row.
DD_BUYER_DISPLAY_NAME=
# PHASE 1: how many companies to pick from /buyer/browse (View Listing -> Express Interest ->
# request documents -> back to browse). Results go to run_state/phase1.json.
DD_BROWSE_INTEREST_COUNT=1
# PHASE 2: which of those uids the currently saved seller session belongs to.
# Leave blank when phase 1 used a single uid.
DD_PHASE2_SELLER_CUE_CARD_UID=

# Cue card uids for that seller's company that the test buyer has NOT expressed interest in yet.
# Each destructive test consumes one uid; add more (comma separated) or reset deals between runs.
DD_FRESH_COMPANY_UIDS=

# Admin deal-notes uid for a deal that already has a document request, and one that does not.
DD_ADMIN_DEAL_WITH_REQUEST_UID=
DD_ADMIN_DEAL_WITHOUT_REQUEST_UID=

# BUYER LOGIN (/buyer/login, module buyer-login). Optional: the whole module runs without them,
# against rewritten responses. Only the tests below need real data.
# A registered QA buyer and the fixed passcode QA accepts for it. Used by the single test that
# completes a real login (marker: live_login) - it sends one real passcode and creates a device
# session, so re-run `python scripts/save_auth_state.py buyer` after a run that used it.
DD_BUYER_LOGIN_EMAIL=
DD_BUYER_LOGIN_OTP=
# An address that is NOT registered, for the real not_registered contract check. Leave blank to
# generate one per run (dd.automation.unknown<timestamp>@example.com).
DD_BUYER_LOGIN_UNREGISTERED_EMAIL=

# HOT LEAD ENGAGEMENT VISIBILITY (feature hot-lead-engagement-visibility, HLE)
# Admin tests (Unverified Deals, Investor Leads) need only DD_ADMIN_STATE. The hot-lead flows
# (test_cases/e2e/test_hot_lead_flows.py, markers destructive + slow) and S2-05 need the values
# below and skip, naming the variable, while one is missing. Every lead must be a DEDICATED buyer
# lead that has never been hot and is never used by auth/buyer.json, the buyer journey or phase 1.
# A lead used once is used up for 14 days: replace its entry before the next run (used links and
# uids are recorded in run_state/hle.json and skipped).
#
# Session of a POC of the S6-01 lead, saved with: python scripts/save_auth_state.py hle_buyer
DD_HLE_BUYER_STATE=auth/hle_buyer.json
# POC cue-card deep links (/buyer/deeplink?listingUid=...&pocUid=...), keyed by test case.
# <case>:<POC A link>|<POC B link>, cases comma separated. Links must not contain commas.
#   S7-01, S8-01: one POC.  S7-03, S8-03: two POCs of the same lead (A first).  S2-05: one POC.
DD_HLE_POC_LINKS=
# How each case's lead appears in the Investor Leads Name column (and Unverified Deals Buyer column):
#   S6-01:<name>,S7-01:<name>,S7-02:<name>,S7-03:<name>,S8-01:<name>,S8-03:<name>,S2-05:<name>
DD_HLE_LEAD_NAMES=
# S6-01: cue card uids the DD_HLE_BUYER_STATE buyer has NOT expressed interest in (one is consumed).
DD_HLE_FRESH_COMPANY_UIDS=
# S7-02: an unlocked investment teaser link for a POC of the S7-02 lead.
DD_HLE_TEASER_UNLOCKED_LINK=
# How long a hot-lead check waits for the scheduler: one 5 min cycle plus a 2 min buffer.
DD_HLE_HOT_POLL_SECONDS=420

# STAR SELLER MARKING - FUNDRAISING (feature star-seller-fundraising, SSF)
# Admin tests need DD_ADMIN_STATE; biz-user tests DD_BIZ_USER_STATE. Sellers are cue card uids
# (/admin/notes/<uid>), keyed by their name in specs/features/star-seller-fundraising/test-cases.md
# section 6; a missing name skips the cases that need it. All must be non-star unless noted.
#   F-ready      funding, 3 highlights (50+ chars), pitch deck, no teaser       S1 (then F-star for S12/S13/S17)
#   F-nodeck     funding, 3 highlights, no pitch deck                          S1-06, S2, S6-03
#   F-empty      funding, < 3 highlights, no pitch deck, no MIS, no call       S3-01/02, S9-02
#   F-short      funding, pitch deck, 3 highlights, one under 50 chars         S3-03
#   F-open       funding open to acquisition, highlights, pitch deck, no teaser S4-01/02
#   F-noconsent  as F-ready with pitch deck consent off                        S4-03 (BLOCKED: setting unknown)
#   A-ready      acquisition, highlights, teaser, no pitch deck                S5-01 (then A-star for S14)
#   A-noteaser   acquisition, highlights, no teaser                            S5-02/03
#   A-empty      acquisition, < 3 highlights, no teaser                        S5-04
#   F-mis        funding, highlights, pitch deck, MIS, no teaser               S6 (then S16-01)
#   F-call / F-nomis / F-dealcall / F-cancelled / F-scheduled                  S7-01, S8-01..04 (call recipes BLOCKED)
#   F-mis-nodeck funding, highlights, MIS, no pitch deck                       S9-01
#   A-biz-nomis / A-biz-mis  acquisition, highlights, teaser, no MIS / MIS     S10
#   Nonstar-funding  non-star funding seller (changed and changed back)       S15-01
#   F-del        as F-ready, pitch decks get DELETED                           S11-01
#   F-star-del   a STAR funding seller whose pitch decks get DELETED           S11-02
#   L-star       funding, highlights, no deck/MIS/call, starred BEFORE the release reaches QA   S18
# Optional: F-star (star funding, no teaser), A-star (star acquisition, teaser, no pitch deck),
# F-star-biz (for S16-01), and per-case sellers for cases that upload the missing document,
# e.g. F-star-S12-05:<uid> (each of S12-04, S12-05, S13-02, S17-01 uses its seller up).
DD_SSF_SELLERS=
